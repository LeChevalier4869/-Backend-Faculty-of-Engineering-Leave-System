# Database
DATABASE_URL="mysql://username:password@host:3306/database_name"

# Backend Configuration
BACKEND_URL="http://localhost:8000"
NODE_ENV="development"
PORT=8000

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Frontend Configuration
FRONTEND_URL="http://localhost:5173"

# JWT - ใช้ค่าที่ซับซ้อนและสุ่มใน production
JWT_SECRET="your_jwt_secret_key_CHANGE_THIS_IN_PRODUCTION"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_CHANGE_THIS_IN_PRODUCTION"
JWT_ACCESS_SECRET="your_jwt_access_secret_key_CHANGE_THIS_IN_PRODUCTION"
JWT_EXPIRESIN="1d"

# Session secret สำหรับ express-session (ใช้ค่าสุ่มยาวๆ ใน production)
SESSION_SECRET="your_session_secret_CHANGE_THIS_IN_PRODUCTION"

# Email Service — ส่งผ่าน Gmail (nodemailer) ของบัญชี Workspace คณะ
# บัญชีผู้ส่ง
EMAIL_USER_RMUTI="your_email@rmuti.ac.th"
EMAIL_USER_RMUTI2="your_second_email@rmuti.ac.th"
# ช่องทางหลัก: Gmail OAuth2 (สร้าง refresh token ผ่าน OAuth2 Playground)
OAUTH_CLIENT_ID_RMUTI="your_oauth_client_id"
OAUTH_CLIENT_SECRET_RMUTI="your_oauth_client_secret"
OAUTH_REFRESH_TOKEN_RMUTI="your_oauth_refresh_token"
# ช่องทางสำรอง: Gmail App Password (ใช้เมื่อ OAuth2 ล้มเหลว — ถ้า Workspace อนุญาต)
EMAIL_APP_PASS="your_app_password"
EMAIL_APP_PASS2="your_second_app_password"

# Cloudinary (Optional)
CLOUDINARY_SECRET="your_cloudinary_secret"

# Prisma migration shadow DB (ใช้เฉพาะตอน prisma migrate dev)
SHADOW_DATABASE_URL="mysql://username:password@host:3306/shadow_database"
